{
  "name": "pi-minions",
  "version": "0.16.2",
  "description": "Minimal recursive subagent orchestration for pi. No bundled agents, no opinions.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalindudc/pi-minions.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@mariozechner/pi-coding-agent": "^0.63.2",
    "@mariozechner/pi-tui": "^0.63.0",
    "@sinclair/typebox": "^0.34.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "prepare": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:json": "vitest run --reporter=json | awk '/^\\{/{found=1} found'",
    "test:e2e": "bash scripts/e2e.sh",
    "test:bench": "bash scripts/test-bench.sh",
    "typecheck": "tsc --noEmit",
    "style": "bash scripts/style.sh",
    "style:check": "biome check ./src ./test",
    "style:fix": "biome check --write --unsafe --no-errors-on-unmatched ./src ./test",
    "format": "biome format --write --no-errors-on-unmatched ./src ./test",
    "cleanup": "bash scripts/cleanup.sh",
    "logs": "bash scripts/logs.sh",
    "profile": "bash scripts/profile.sh",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "config": {
    "loglevel": "silent"
  }
}